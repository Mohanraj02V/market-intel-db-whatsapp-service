# =============================================================================
# .env.example
# Copy to .env and fill in ALL values before deploying.
# NEVER commit .env to Git.
# =============================================================================

# =============================================================================
# DOMAIN
# =============================================================================
# The subdomain pointing to this Oracle VM's public IP.
# Example: whatsapp.yourdomain.com
DOMAIN=whatsapp.yourdomain.com

# Email for Let's Encrypt certificate notifications.
CERTBOT_EMAIL=admin@yourdomain.com

# =============================================================================
# WAHA CONFIGURATION
# =============================================================================
# WhatsApp engine -- keep as NOWEB for the noweb-arm image.
WAHA_ENGINE=NOWEB

# API key for authenticating Django -> WAHA requests.
# STRONG REQUIREMENT: Must be sha512-hashed before setting here.
#
# HOW TO GENERATE:
#   1. Generate a strong random plaintext key (save it separately, securely):
#      python3 -c "import secrets; print(secrets.token_hex(64))"
#
#   2. Hash it:
#      echo -n "YOUR_PLAINTEXT_KEY" | sha512sum | awk '{print "sha512:" $1}'
#
#   3. Set the HASH here.
#   4. Set the PLAINTEXT in Django as WHATSAPP_SERVICE_API_KEY.
#
# NEVER set the plaintext here.
WAHA_API_KEY=sha512:REPLACE_WITH_SHA512_HASH_OF_YOUR_API_KEY

# Dashboard credentials (separate from API key).
WAHA_DASHBOARD_ENABLED=true
WAHA_DASHBOARD_USERNAME=admin
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WAHA_DASHBOARD_PASSWORD=REPLACE_WITH_STRONG_DASHBOARD_PASSWORD

# =============================================================================
# WEBHOOK SECURITY
# =============================================================================
# HMAC secret shared between WAHA and Django.
# WAHA signs outgoing webhook payloads with this.
# Django verifies the signature before processing any event.
#
# Generate: python3 -c "import secrets; print(secrets.token_hex(64))"
# This value must match WHATSAPP_WEBHOOK_SECRET in the Django .env.
WHATSAPP_WEBHOOK_SECRET=REPLACE_WITH_STRONG_WEBHOOK_HMAC_SECRET

# =============================================================================
# DJANGO WEBHOOK ENDPOINT
# =============================================================================
# The public URL of the Django endpoint that receives WAHA webhook events.
# Example: https://api.yourdomain.com/api/whatsapp/webhook/
DJANGO_WEBHOOK_URL=https://api.yourdomain.com/api/whatsapp/webhook/

# =============================================================================
# WAHA WEBHOOK EVENTS
# =============================================================================
# Comma-separated list of WAHA event types to forward to Django.
# Only subscribe to events you actually process.
WAHA_HOOK_EVENTS=message,message.ack,session.status

# =============================================================================
# WAHA MEDIA / LOGGING
# =============================================================================
# Seconds before WAHA purges temporary media files.
WAHA_MEDIA_LIFETIME_SECONDS=3600

WAHA_LOG_LEVEL=info
WAHA_LOG_FORMAT=json

# =============================================================================
# STORAGE PATHS
# =============================================================================
# These directories are created by setup.sh with restricted permissions.
# Do not change unless you also update setup.sh.
WAHA_SESSION_PATH=./data/sessions
NGINX_CERT_PATH=./data/certs
NGINX_WEBROOT_PATH=./data/webroot
